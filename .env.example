OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
WHISPER_MODEL=base
FFMPEG_PATH=
FFPROBE_PATH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8770/api/drive/callback
GOOGLE_DRIVE_FOLDER_ID=

# local: API aberta, sem autenticação (padrão para o ambiente local existente).
# required: bloqueia a API enquanto a integração real de autenticação não existe.
# Qualquer outro valor bloqueia o acesso. Não exponha o modo local na internet.
AUTH_MODE=local
# Placeholders para uma etapa futura. Preenchê-los NÃO habilita login ou proteção.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Nunca colocar service_role/secret key na interface ou em arquivos públicos.
